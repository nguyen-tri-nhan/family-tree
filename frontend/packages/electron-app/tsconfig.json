{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@family-tree/tree-lib": ["../tree-lib/src/index.ts"]
    },
    "types": ["electron", "node"]
  },
  "include": ["src"]
}
